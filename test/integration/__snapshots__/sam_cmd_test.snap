ENV_AWS_ENDPOINT_URL=http://<endpoint-host>:4566
ENV_AWS_ENDPOINT_URL_S3=<unset>
ENV_AWS_REGION=us-east-1
ENV_AWS_DEFAULT_REGION=us-east-1
ENV_AWS_ACCESS_KEY_ID=123456789012
ENV_AWS_SECRET_ACCESS_KEY=test
ENV_AWS_PROFILE=<unset>
ENV_AWS_DEFAULT_PROFILE=<unset>
ENV_AWS_SESSION_TOKEN=<unset>
---

